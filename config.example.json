{
  "whisper_model": "large",
  "language": "ru",
  "sample_rate": 16000,
  "chunk_seconds": 300,
  "silence_threshold": 0.001,
  "silence_min_seconds": 3,
  "transcripts_dir": "transcripts",
  "recordings_dir": "recordings",
  "keep_audio": false,
  "status_file": "logs/status.json",
  "forced_meeting_file": "logs/forced_meeting.json",
  "hf_token": "hf_YOUR_HUGGINGFACE_TOKEN",
  "diarization_enabled": true,
  "max_speakers": 8,
  "loopback_device": null,
  "mic_device": null,
  "mic_gain": 1.0,
  "loopback_gain": 0.85,
  "whisper_device": "auto",
  "cpu_threads": 4,
  "gpu_memory_fraction": 0.8,
  "max_parallel_chunks": 1,
  "save_training_data": false,
  "ram_limit_gb": 16,
  "whisper_initial_prompt": "Рабочее совещание на русском языке.",
  "whisper_no_speech_threshold": 0.3,
  "whisper_logprob_threshold": -1.5,
  "whisper_compression_ratio_threshold": 3.0,
  "obsidian_url": "https://127.0.0.1:27124",
  "obsidian_api_key": "YOUR_OBSIDIAN_LOCAL_REST_API_KEY"
}
